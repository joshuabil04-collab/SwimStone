<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Billotte Swim Analysis — Race Video Breakdowns for Age-Group Swimmers</title>
<meta name="description" content="Send your swimmer's race video and get a coach's frame-by-frame breakdown within 48 hours. Built for age-group swimmers and the parents filming them.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%230B1220'/%3E%3Ctext x='50' y='66' font-family='Arial' font-weight='900' font-size='42' fill='%23F2B84B' text-anchor='middle'%3EJB%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800;900&family=Manrope:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  * { margin:0; padding:0; box-sizing:border-box; }

  :root{
    --ink:#0B1220;
    --pool:#12324A;
    --pool-2:#0E2638;
    --cyan:#3FD6E0;
    --gold:#F2B84B;
    --coral:#FF6B57;
    --foam:#F6FBFB;
    --white:#FFFFFF;
    --navy:#132538;
    --navy-soft:#51697D;
    --border:#E1EEEE;
    --font-display:"Big Shoulders Display", sans-serif;
    --font-body:"Manrope", sans-serif;
    --font-mono:"Space Mono", monospace;
    --container:1120px;
  }

  html{ -webkit-font-smoothing:antialiased; }
  @media (prefers-reduced-motion: no-preference){ html{ scroll-behavior:smooth; } }

  body{
    font-family:var(--font-body);
    color:var(--navy);
    background:var(--foam);
    line-height:1.6;
  }

  img, svg{ display:block; max-width:100%; }
  a{ color:inherit; text-decoration:none; }
  ul{ list-style:none; }
  button{ font:inherit; background:none; border:none; cursor:pointer; color:inherit; }

  .container{ max-width:var(--container); margin:0 auto; padding:0 28px; }

  h1,h2,h3{
    font-family:var(--font-display);
    font-weight:800;
    line-height:1.03;
    letter-spacing:0.2px;
    text-transform:uppercase;
    color:var(--navy);
  }

  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:10px;
    font-family:var(--font-mono);
    font-size:12px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--navy-soft);
    font-weight:700;
  }
  .eyebrow::before{
    content:"";
    width:8px; height:8px;
    border-radius:50%;
    background:var(--cyan);
    display:inline-block;
  }

  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible{
    outline:3px solid var(--cyan);
    outline-offset:3px;
    border-radius:4px;
  }

  .section{ padding:104px 0; }
  .section__head{ max-width:640px; margin-bottom:56px; }
  .section__head h2{ font-size:clamp(30px,4vw,46px); margin-top:14px; }
  .section__head p{ color:var(--navy-soft); font-size:17px; margin-top:16px; max-width:52ch; }
  .section--dark{ background:linear-gradient(180deg, var(--pool-2), var(--ink)); color:var(--foam); }
  .section--dark h2, .section--dark h3{ color:var(--foam); }
  .section--dark .eyebrow{ color:var(--cyan); }
  .section--dark p{ color:rgba(246,251,251,0.78); }

  .btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-family:var(--font-body);
    font-weight:700;
    font-size:15px;
    padding:15px 28px;
    border-radius:999px;
    border:2px solid transparent;
    cursor:pointer;
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease, color .18s ease;
    white-space:nowrap;
  }
  .btn:hover{ transform:translateY(-2px); }
  .btn--primary{ background:var(--gold); color:var(--ink); }
  .btn--primary:hover{ box-shadow:0 14px 28px rgba(242,184,75,0.32); }
  .btn--ghost{ background:transparent; color:var(--foam); border-color:rgba(246,251,251,0.35); }
  .btn--ghost:hover{ border-color:var(--cyan); color:var(--cyan); }
  .btn--outline{ background:transparent; color:var(--navy); border-color:var(--border); }
  .btn--outline:hover{ border-color:var(--pool); }

  /* ---------- NAV ---------- */
  .nav{
    position:sticky; top:0; z-index:60;
    background:rgba(11,18,32,0.88);
    backdrop-filter:blur(10px);
    border-bottom:1px solid rgba(255,255,255,0.08);
  }
  .nav .container{ display:flex; align-items:center; justify-content:space-between; height:78px; position:relative; }
  .nav__brand{ display:flex; align-items:center; gap:12px; }
  .nav__mark{
    width:42px; height:42px; border-radius:11px; background:var(--gold);
    display:flex; align-items:center; justify-content:center;
    font-family:var(--font-display); font-weight:900; color:var(--ink); font-size:18px;
    flex-shrink:0;
  }
  .nav__word{ font-family:var(--font-display); font-weight:800; color:var(--foam); font-size:16px; letter-spacing:0.05em; }
  .nav__word small{ display:block; font-family:var(--font-mono); font-size:10px; color:var(--cyan); letter-spacing:0.14em; font-weight:400; text-transform:uppercase; margin-top:2px; }
  .nav__links{ display:flex; gap:34px; align-items:center; }
  .nav__links a{ font-size:14px; font-weight:600; color:rgba(246,251,251,0.82); transition:color .15s ease; }
  .nav__links a:hover{ color:var(--cyan); }
  .nav__right{ display:flex; align-items:center; gap:18px; }
  .nav__toggle{ display:none; flex-direction:column; gap:5px; padding:8px; }
  .nav__toggle span{ width:22px; height:2px; background:var(--foam); border-radius:2px; }

  /* ---------- HERO ---------- */
  .hero{
    background:
      radial-gradient(circle at 15% -10%, rgba(63,214,224,0.16), transparent 45%),
      linear-gradient(180deg, var(--ink) 0%, var(--pool-2) 100%);
    color:var(--foam);
    padding:88px 0 110px;
    overflow:hidden;
  }
  .hero__pill{
    display:inline-flex; align-items:center; gap:9px;
    font-family:var(--font-mono); font-size:12px; letter-spacing:0.1em; text-transform:uppercase;
    color:var(--cyan);
    border:1px solid rgba(63,214,224,0.35);
    padding:8px 16px; border-radius:999px;
    margin-bottom:26px;
  }
  .hero__pill i{ width:7px; height:7px; border-radius:50%; background:var(--cyan); display:inline-block; animation:pulse 2s ease-in-out infinite; }
  .hero h1{
    font-size:clamp(42px, 6.6vw, 88px);
    color:var(--foam);
    max-width:900px;
  }
  .hero h1 em{ font-style:normal; color:var(--gold); }
  .hero__sub{
    font-size:clamp(16px,1.8vw,19px);
    color:rgba(246,251,251,0.8);
    max-width:56ch;
    margin-top:24px;
  }
  .hero__ctas{ display:flex; gap:16px; flex-wrap:wrap; margin-top:36px; }

  .scrub-card{
    margin-top:72px;
    background:linear-gradient(180deg, rgba(18,50,74,0.85), rgba(14,38,56,0.92));
    border:1px solid rgba(63,214,224,0.25);
    border-radius:22px;
    padding:30px;
    box-shadow:0 40px 90px rgba(0,0,0,0.4);
  }
  .scrub-card__tag{
    font-family:var(--font-mono); font-size:11px; letter-spacing:0.1em; text-transform:uppercase;
    color:rgba(246,251,251,0.55); margin-bottom:16px;
  }
  .scrub-card__frame{
    position:relative;
    border-radius:16px;
    overflow:hidden;
    background:linear-gradient(180deg, rgba(63,214,224,0.1), rgba(11,18,32,0.55));
    padding:30px 24px 22px;
    min-height:200px;
  }
  .scrub-card__play{
    position:absolute; top:38%; left:50%; transform:translate(-50%,-50%);
    width:76px; height:76px; border-radius:50%;
    background:rgba(246,251,251,0.14);
    border:1.5px solid rgba(246,251,251,0.4);
    display:flex; align-items:center; justify-content:center;
  }
  .scrub-card__play svg{ width:22px; height:22px; }
  .scrub-card__swimmer{ width:100%; opacity:0.9; }

  .scrub{ margin-top:22px; }
  .scrub__track{ position:relative; height:4px; background:rgba(246,251,251,0.18); border-radius:4px; margin:0 6px; }
  .scrub__fill{ position:absolute; left:0; top:0; height:100%; width:63%; background:var(--cyan); border-radius:4px; opacity:0.7; }
  .scrub__playhead{ position:absolute; top:50%; width:14px; height:14px; border-radius:50%; background:var(--gold); transform:translate(-50%,-50%); box-shadow:0 0 0 4px rgba(242,184,75,0.22); }
  .scrub__pin{ position:absolute; top:50%; width:9px; height:9px; border-radius:50%; background:var(--foam); transform:translate(-50%,-50%); animation:pulse 2.6s ease-in-out infinite; }
  .scrub__notes{ display:grid; grid-template-columns:repeat(4,1fr); gap:18px; margin-top:22px; }
  .scrub__note{ display:flex; flex-direction:column; gap:6px; }
  .scrub__time{ font-family:var(--font-mono); font-size:13px; color:var(--gold); font-weight:700; }
  .scrub__note span:last-child{ font-size:14px; color:rgba(246,251,251,0.85); font-weight:500; }
  .scrub-card__caption{ font-size:14px; color:rgba(246,251,251,0.55); margin-top:24px; }

  @keyframes pulse{ 0%,100%{ opacity:1; } 50%{ opacity:0.35; } }

  /* ---------- GAP SECTION ---------- */
  .gap-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:36px; }
  .gap-card__label{ font-family:var(--font-mono); font-size:12px; letter-spacing:0.1em; color:var(--pool); font-weight:700; }
  .gap-card h3{ font-size:19px; text-transform:none; letter-spacing:0; margin-top:10px; margin-bottom:12px; }
  .gap-card p{ color:var(--navy-soft); font-size:15.5px; }

  /* ---------- HOW IT WORKS ---------- */
  .steps{ display:grid; grid-template-columns:repeat(4,1fr); gap:28px; }
  .step{ position:relative; padding-top:8px; border-top:2px solid var(--border); }
  .step__num{ font-family:var(--font-mono); font-size:15px; font-weight:700; color:var(--cyan); background:var(--ink); display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; border-radius:50%; margin-top:-25px; margin-bottom:20px; }
  .step h3{ font-size:16.5px; letter-spacing:0.02em; margin-bottom:10px; }
  .step p{ color:var(--navy-soft); font-size:15px; }

  /* ---------- SAMPLE BREAKDOWN ---------- */
  .sample-card{
    background:var(--ink);
    border-radius:22px;
    padding:40px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:44px;
    align-items:center;
    color:var(--foam);
  }
  .sample-card__mini .scrub-card__frame{ min-height:140px; padding:20px; }
  .sample-card__mini .scrub__notes{ grid-template-columns:1fr; gap:10px; margin-top:16px; }
  .sample-card__mini .scrub__note{ flex-direction:row; gap:10px; align-items:baseline; }
  .sample-card__badge{ font-family:var(--font-mono); font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:rgba(246,251,251,0.5); margin-bottom:14px; }
  .sample-card__right h3{ color:var(--foam); font-size:22px; margin-bottom:18px; }
  .sample-list{ display:flex; flex-direction:column; gap:12px; margin-bottom:24px; }
  .sample-list li{ display:flex; gap:10px; font-size:15px; color:rgba(246,251,251,0.85); }
  .sample-list li::before{ content:"→"; color:var(--gold); font-weight:700; flex-shrink:0; }
  .sample-drills{ font-size:13px; font-family:var(--font-mono); color:rgba(246,251,251,0.5); letter-spacing:0.02em; }

  .feature-row{ display:grid; grid-template-columns:repeat(3,1fr); gap:32px; margin-top:56px; }
  .feature-row__item h4{ font-family:var(--font-mono); font-size:14px; color:var(--pool); letter-spacing:0.02em; margin-bottom:8px; }
  .feature-row__item p{ color:var(--navy-soft); font-size:15px; }

  /* ---------- PRICING ---------- */
  .pricing-group{ margin-top:44px; }
  .pricing-group__label{ font-family:var(--font-mono); font-size:12.5px; letter-spacing:0.08em; text-transform:uppercase; color:var(--navy-soft); font-weight:700; margin-bottom:18px; }
  .pricing-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:28px; }
  .price-card{ background:var(--white); border:1.5px solid var(--border); border-top:4px solid var(--cyan); border-radius:18px; padding:38px; display:flex; flex-direction:column; gap:16px; position:relative; }
  .price-card--premium{ border-top-color:var(--gold); }
  .price-card__name{ font-size:14px; font-weight:800; letter-spacing:0.04em; color:var(--navy-soft); text-transform:uppercase; }
  .price-card__amount{ font-family:var(--font-mono); font-size:48px; font-weight:700; color:var(--navy); }
  .price-card__amount span{ font-size:15px; color:var(--navy-soft); font-weight:400; margin-left:4px; }
  .price-card ul{ display:flex; flex-direction:column; gap:11px; margin:6px 0 8px; }
  .price-card li{ display:flex; gap:10px; font-size:14.5px; color:var(--navy-soft); align-items:flex-start; }
  .price-card li::before{ content:"✓"; color:var(--cyan); font-weight:700; flex-shrink:0; }
  .pricing-callout{ margin-top:40px; border:1.5px solid var(--border); background:var(--foam); border-radius:16px; padding:26px 30px; display:flex; flex-direction:column; gap:10px; }
  .pricing-callout p{ font-size:14.5px; color:var(--navy-soft); }
  .pricing-callout strong{ color:var(--navy); }
  .pricing-callout a{ color:var(--pool); font-weight:700; text-decoration:underline; }

  /* ---------- ABOUT ---------- */
  .about-grid{ display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:start; }
  .avatar{ width:100px; height:100px; border-radius:50%; background:linear-gradient(135deg, var(--pool), var(--ink)); color:var(--gold); display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-size:38px; font-weight:900; border:3px solid var(--gold); margin-bottom:24px; }
  .about-name{ font-size:26px; margin-bottom:6px; }
  .about-title{ color:var(--navy-soft); font-size:14.5px; font-weight:600; margin-bottom:22px; }
  .about-bio{ color:var(--navy-soft); font-size:16px; }
  .chips{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .chip{ border:1.5px solid var(--border); border-radius:12px; padding:15px 16px; font-size:13.5px; font-weight:600; color:var(--navy); background:var(--white); line-height:1.35; }

  /* ---------- TESTIMONIALS ---------- */
  .testimonial-head{ display:flex; align-items:baseline; gap:14px; flex-wrap:wrap; }
  .sample-tag{ font-family:var(--font-mono); font-size:11px; letter-spacing:0.06em; text-transform:uppercase; color:var(--navy-soft); background:var(--white); border:1px solid var(--border); padding:5px 11px; border-radius:999px; }
  .quote-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:32px; }
  .quote-card{ background:var(--white); border:1.5px solid var(--border); border-radius:16px; padding:30px; display:flex; flex-direction:column; gap:18px; }
  .quote-card p{ font-size:15.5px; color:var(--navy); }
  .quote-card cite{ font-style:normal; font-size:13px; color:var(--navy-soft); font-weight:700; }

  /* ---------- FAQ ---------- */
  .faq-list{ max-width:760px; }
  .faq-item{ border-bottom:1px solid var(--border); }
  .faq-item__q{ width:100%; display:flex; align-items:center; justify-content:space-between; gap:20px; padding:24px 4px; text-align:left; font-size:16.5px; font-weight:700; color:var(--navy); }
  .faq-item__icon{ font-family:var(--font-mono); font-size:20px; color:var(--pool); transition:transform .25s ease; flex-shrink:0; }
  .faq-item.is-open .faq-item__icon{ transform:rotate(45deg); }
  .faq-item__a{ display:grid; grid-template-rows:0fr; transition:grid-template-rows .3s ease; }
  .faq-item__a-inner{ overflow:hidden; }
  .faq-item__a-inner p{ padding:0 4px 24px; color:var(--navy-soft); font-size:15px; max-width:64ch; }
  .faq-item.is-open .faq-item__a{ grid-template-rows:1fr; }

  /* ---------- FOOTER / CONTACT ---------- */
  .footer{ padding:104px 0 40px; }
  .footer .section__head{ max-width:600px; }
  .contact-grid{ display:grid; grid-template-columns:1.25fr 1fr; gap:64px; margin-top:12px; }
  .field{ display:flex; flex-direction:column; gap:7px; }
  .field label{ font-size:13px; font-weight:700; color:var(--foam); }
  .field input, .field select, .field textarea{
    font-family:var(--font-body); font-size:15px; padding:13px 14px;
    border:1.5px solid rgba(246,251,251,0.2); border-radius:10px;
    background:rgba(246,251,251,0.06); color:var(--foam);
  }
  .field input::placeholder, .field textarea::placeholder{ color:rgba(246,251,251,0.4); }
  .field select{ color:var(--foam); }
  .field select option{ color:var(--ink); }
  .field input:focus, .field select:focus, .field textarea:focus{ border-color:var(--cyan); outline:none; }
  .contact-form{ display:grid; gap:18px; }
  .row-2{ display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  .form-hint{ font-size:13px; color:rgba(246,251,251,0.5); margin-top:-4px; }
  .field-hint{ font-size:12.5px; color:rgba(246,251,251,0.55); margin-top:1px; }
  .field-hint a{ color:var(--cyan); font-weight:600; text-decoration:underline; }
  #form-status{ font-size:13.5px; color:var(--cyan); min-height:18px; }

  .direct h3{ color:var(--foam); font-size:15px; letter-spacing:0.04em; margin-bottom:20px; }
  .direct-item{ display:block; font-size:16px; font-weight:700; color:var(--foam); margin-bottom:6px; }
  .direct-sub{ font-size:14px; color:rgba(246,251,251,0.6); margin-bottom:26px; }
  .social-row{ display:flex; gap:14px; margin-top:8px; }
  .social-row a{ width:38px; height:38px; border-radius:50%; border:1px solid rgba(246,251,251,0.25); display:flex; align-items:center; justify-content:center; transition:border-color .15s ease, color .15s ease; }
  .social-row a:hover{ border-color:var(--cyan); color:var(--cyan); }
  .social-row svg{ width:16px; height:16px; }

  .footer-bottom{ margin-top:90px; padding-top:28px; border-top:1px solid rgba(246,251,251,0.12); display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; font-size:13px; color:rgba(246,251,251,0.45); }

  /* ---------- REVEAL ---------- */
  .reveal{ opacity:0; transform:translateY(24px); transition:opacity .6s ease, transform .6s ease; }
  .reveal.is-visible{ opacity:1; transform:translateY(0); }

  @media (prefers-reduced-motion: reduce){
    .reveal{ opacity:1; transform:none; transition:none; }
    .hero__pill i, .scrub__pin{ animation:none; }
    *{ scroll-behavior:auto !important; }
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width:960px){
    .nav__links{ display:none; }
    .nav--open .nav__links{
      display:flex; flex-direction:column; align-items:flex-start; gap:20px;
      position:absolute; top:78px; left:0; right:0; background:var(--ink);
      padding:26px 28px; border-bottom:1px solid rgba(255,255,255,0.08);
    }
    .nav__toggle{ display:flex; }
    .gap-grid, .steps, .quote-grid{ grid-template-columns:1fr; gap:32px; }
    .step{ border-top:none; border-left:2px solid var(--border); padding-left:20px; padding-top:0; }
    .step__num{ margin-top:0; margin-left:-17px; }
    .sample-card{ grid-template-columns:1fr; }
    .pricing-grid{ grid-template-columns:1fr; }
    .about-grid{ grid-template-columns:1fr; gap:40px; }
    .chips{ grid-template-columns:1fr 1fr; }
    .contact-grid{ grid-template-columns:1fr; gap:48px; }
    .feature-row{ grid-template-columns:1fr; gap:28px; }
    .section{ padding:76px 0; }
  }
  @media (max-width:640px){
    .scrub__notes{ grid-template-columns:1fr 1fr; }
    .row-2{ grid-template-columns:1fr; }
    .hero__ctas .btn{ width:100%; justify-content:center; }
    .chips{ grid-template-columns:1fr; }
  }
</style>
</head>
<body>

<!-- ================= NAV ================= -->
<header class="nav" id="top">
  <div class="container">
    <a class="nav__brand" href="#top">
      <span class="nav__mark">JB</span>
      <span class="nav__word">BILLOTTE<small>Swim Analysis</small></span>
    </a>
    <nav class="nav__links">
      <a href="#how-it-works">How It Works</a>
      <a href="#sample">What You Get</a>
      <a href="#pricing">Pricing</a>
      <a href="#about">About</a>
      <a href="#faq">FAQ</a>
    </nav>
    <div class="nav__right">
      <a href="#contact" class="btn btn--primary">Submit a Video</a>
      <button class="nav__toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- ================= HERO ================= -->
<section class="hero">
  <div class="container">
    <span class="hero__pill"><i></i>Now booking — 48-hour turnaround</span>
    <h1>Film it. Learn it. Swim <em>faster.</em></h1>
